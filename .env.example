# ─── TimeBox Environment Configuration ──────────────────
#
# Copy this file to .env and adjust for your setup.
# The .env file is git-ignored and won't be committed.

# Daily note directory — where TimeBox syncs punch entries.
# Default: ~/Documents/Notes/Today/
# Format: files named YYYY-MM.md with sections like "## M.D"
# NOTE_DIR=~/Documents/Notes/Today/
